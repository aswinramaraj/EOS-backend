    {
      "name": "🛡 Protected Routes",
      "item": [
        {
          "name": "GET /auth/me  (uses saved token)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Has user data', () => {", "  const body = pm.response.json();", "  pm.expect(body.success).to.be.true;", "  pm.expect(body.data.email).to.be.a('string');", "  pm.expect(body.data.roles.name).to.be.a('string');", "});"], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{base_url}}/auth/me", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "GET /auth/me  ❌ No Token (expect 401)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));", "pm.test('Rejected without token', () => pm.expect(pm.response.json().success).to.be.false);"], "type": "text/javascript" }}],
          "request": { "method": "GET", "url": "{{base_url}}/auth/me", "header": [] }
        },
        {
          "name": "POST /auth/login  ❌ Wrong password (expect 401)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" }}],
          "request": { "method": "POST", "url": "{{base_url}}/auth/login", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@eos.test\",\n  \"password\": \"wrongpassword\"\n}" } }
        },
        {
          "name": "POST /auth/login  ❌ Invalid email format (expect 400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 400', () => pm.response.to.have.status(400));"], "type": "text/javascript" }}],
          "request": { "method": "POST", "url": "{{base_url}}/auth/login", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"EOS@test123\"\n}" } }
        }
