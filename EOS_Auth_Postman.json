{
  "info": {
    "name": "EOS Backend – Auth Tests",
    "_postman_id": "eos-auth-collection-v1",
    "description": "Test JWT login and role-based access for all 16 roles.\n\nPassword for all test accounts: **EOS@test123**\n\nWorkflow:\n1. Run any Login request → the token is auto-saved to {{token}}\n2. Use GET /auth/me or any protected route — it reads {{token}} automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "token",    "value": "",                              "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login as ADMIN",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) {", "  const body = pm.response.json();", "  pm.collectionVariables.set('token', body.data.accessToken);", "  pm.test('Login successful', () => pm.response.to.have.status(200));", "  pm.test('Token received',   () => pm.expect(body.data.accessToken).to.be.a('string'));", "  pm.test('Role is admin',    () => pm.expect(body.data.user.role).to.eql('admin'));", "}"], "type": "text/javascript" }}],
          "request": { "method": "POST", "url": "{{base_url}}/auth/login", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@eos.test\",\n  \"password\": \"EOS@test123\"\n}" } }
